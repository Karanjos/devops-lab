// Generated by Ansible - do not edit by hand, edit group_vars/jenkins/ instead.
//
// Runs on every Jenkins boot (init.groovy.d scripts aren't one-shot). Creates the admin
// account once, then leaves it alone - re-running this doesn't reset the password, so
// changing vault_jenkins_admin_password later needs a manual password reset too, not just
// a re-run of the playbook. That's deliberate: a script that reset the password on every
// boot would also silently undo a password change made by hand in the Jenkins UI.
import jenkins.model.*
import hudson.security.*
import jenkins.install.*

def instance = Jenkins.getInstance()

def hudsonRealm = new HudsonPrivateSecurityRealm(false)
if (hudsonRealm.getAllUsers().find { it.id == "{{ jenkins_admin_user }}" } == null) {
    hudsonRealm.createAccount("{{ jenkins_admin_user }}", "{{ jenkins_admin_password }}")
}
instance.setSecurityRealm(hudsonRealm)

def strategy = new FullControlOnceLoggedInAuthorizationStrategy()
strategy.setAllowAnonymousRead(false)
instance.setAuthorizationStrategy(strategy)

// No separate agent anymore - this box builds its own jobs, so the built-in node needs
// executors. A fresh Jenkins install already defaults to 2, this just makes it explicit
// and keeps it that way even if someone changes it by hand in the UI later.
instance.setNumExecutors({{ jenkins_executors }})

instance.setInstallState(InstallState.INITIAL_SETUP_COMPLETED)
instance.save()
